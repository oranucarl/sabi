# Copy to .env and fill in only what you need. Everything works without any keys.

# Local model server (default: http://localhost:11434)
SABI_OLLAMA_URL=
# Vision model for screen questions (default: qwen2.5vl:7b; use qwen2.5vl:3b on 8 GB Macs)
SABI_VISION_MODEL=
# Embedding model for cited document search (default: nomic-embed-text)
SABI_EMBED_MODEL=

# ChatGPT Plus/Pro is connected inside SAbi with "Continue with ChatGPT"; it needs no .env key.
# Optional legacy alternative: bring your own Claude API key (billed separately).
ANTHROPIC_API_KEY=
SABI_ANTHROPIC_MODEL=

# Speech recognition model size: tiny | base | small | medium (default: small)
SABI_WHISPER_MODEL=
# Reply language: auto | en | pcm (Nigerian Pidgin) | fr | pt | ar | sw | yo | ha | ig
SABI_REPLY_LANGUAGE=
# Voice: edge (neural voices, needs internet; falls back automatically) | say (fully offline)
SABI_TTS=
# Where the journal and library live (default: ~/Library/Application Support/Sabi)
SABI_DATA_DIR=
